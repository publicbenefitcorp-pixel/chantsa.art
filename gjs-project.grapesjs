nents":[{"type":"textnode","content":"Oil and cold wax · 80 × 80 cm"}]}]}]},{"tagName":"article","classes":["group","artwork-card","artwork-card-refined"],"attributes":{"id":"if8btk"},"components":[{"classes":["artwork-image-wrap","artwork-image-frame"],"attributes":{"id":"i633xh"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["artwork-image","artwork-image-uniform"],"attributes":{"src":"https://app.grapesjs.com/api/assets/random-image?query=gallery%20painting%20detail&w=900&h=980","alt":"Textural painting detail","width":"900","height":"980","loading":"lazy","id":"i80tmk"}}]},{"classes":["artwork-content","artwork-content-refined"],"attributes":{"id":"ic9g1e"},"components":[{"name":"Artwork Header Row","classes":["artwork-topline"],"components":[{"tagName":"h3","type":"heading","classes":["font-display","artwork-name","artwork-name-refined"],"attributes":{"id":"icmv8p"},"components":[{"type":"textnode","content":"Interior Light"}]},{"tagName":"span","type":"text","classes":["artwork-year","artwork-year-refined"],"attributes":{"id":"ixdfc7"},"components":[{"type":"textnode","content":"2023"}]}]},{"tagName":"p","type":"text","classes":["artwork-details","artwork-meta-line"],"attributes":{"id":"ib7ckm"},"components":[{"type":"textnode","content":"Acrylic and graphite · 65 × 90 cm"}]}]}]},{"tagName":"article","classes":["group","artwork-card","artwork-card-refined"],"attributes":{"id":"itpo08"},"components":[{"classes":["artwork-image-wrap","artwork-image-frame"],"attributes":{"id":"izdk6k"},"components":[{"type":"image","resizable":{"ratioDefault":1},"classes":["artwork-image","artwork-image-uniform"],"attributes":{"src":"https://app.grapesjs.com/api/assets/random-image?query=moody%20abstract%20canvas&w=900&h=1250","alt":"Moody abstract canvas painting","width":"900","height":"1250","loading":"lazy","id":"imb55l"}}]},{"classes":["artwork-content","artwork-content-refined"],"attributes":{"id":"it92rl"},"components":[{"name":"Artwork Header Row","classes":["artwork-topline"],"components":[{"tagName":"h3","type":"heading","classes":["font-display","artwork-name","artwork-name-refined"],"attributes":{"id":"i13dnh"},"components":[{"type":"textnode","content":"Holding Blue"}]},{"tagName":"span","type":"text","classes":["artwork-year","artwork-year-refined"],"attributes":{"id":"is820e"},"components":[{"type":"textnode","content":"2024"}]}]},{"tagName":"p","type":"text","classes":["artwork-details","artwork-meta-line"],"attributes":{"id":"ise83t"},"components":[{"type":"textnode","content":"Oil on canvas · 100 × 140 cm"}]}]}]}]},{"name":"Works Footer Note","classes":["works-note"],"components":[{"tagName":"span","type":"text","name":"Footer Label","components":[{"type":"textnode","content":"Studio selection · Available works and archival studies"}]},{"tagName":"span","name":"Divider Rule","classes":["works-rule"]},{"tagName":"span","type":"text","name":"Footer Label","components":[{"type":"textnode","content":"Scroll for artist background and statement"}]}]}]}]},{"tagName":"section","name":"About Section","classes":["about-section"],"attributes":{"id":"about"},"components":[{"name":"About Card","classes":["about-card"],"components":[{"name":"About Portrait Column","classes":["about-portrait-column"],"components":[{"name":"Portrait Frame","classes":["portrait-frame"],"components":[{"type":"image","name":"Portrait Image","resizable":{"ratioDefault":1},"classes":["portrait-image"],"attributes":{"src":"https://app.grapesjs.com/api/assets/random-image?query=woman%20artist%20studio%20portrait&w=900&h=1100","alt":"Portrait of the artist in her studio","width":"900","height":"1100","loading":"lazy"}}]}]},{"name":"About Content Column","classes":["about-content-column"],"components":[{"name":"About Text Group","classes":["about-text-group"],"components":[{"tagName":"span","type":"text","name":"Section Eyebrow","classes":["section-eyebrow"],"components":[{"type":"textnode","content":"About the Artist"}]},{"tagName":"h2","type":"heading","name":"About Title","classes":["gjs-t-h2","font-display","about-title"],"components":[{"type":"textnode","content":"A practice shaped by observation, erosion, and atmosphere"}]},{"tagName":"p","type":"text","name":"About Paragraph","classes":["about-paragraph"],"components":[{"type":"textnode","content":"\n                Based between the coast and the city, Elena Maris develops paintings that sit between abstraction and landscape. Her work begins with field sketches, fragments of writing, and collected color notes, then evolves in the studio through repeated layering and removal. The resulting surfaces carry traces of place while remaining open, quiet, and unresolved in compelling ways.\n              "}]},{"tagName":"p","type":"text","name":"About Paragraph","classes":["about-paragraph"],"components":[{"type":"textnode","content":"\n                Her paintings are held in private collections and have been exhibited in independent project spaces, regional galleries, and curated group exhibitions focused on contemporary material practice.\n              "}]}]},{"name":"About Details Grid","classes":["about-details-grid"],"components":[{"name":"Detail Card","classes":["detail-card"],"components":[{"tagName":"p","type":"text","name":"Detail Label","classes":["detail-label"],"components":[{"type":"textnode","content":"Mediums"}]},{"tagName":"p","type":"text","name":"Detail Value","classes":["detail-value"],"components":[{"type":"textnode","content":"Oil, acrylic, charcoal, chalk, cold wax, and mixed media on linen, canvas, and paper."}]}]},{"name":"Detail Card","classes":["detail-card"],"components":[{"tagName":"p","type":"text","name":"Detail Label","classes":["detail-label"],"components":[{"type":"textnode","content":"Available For"}]},{"tagName":"p","type":"text","name":"Detail Value","classes":["detail-value"],"components":[{"type":"textnode","content":"Original works, commissions, exhibition opportunities, studio visits, and editorial collaborations."}]}]}]}]}]}]},{"tagName":"section","name":"Exhibitions Section","classes":["exhibitions-section"],"attributes":{"id":"exhibitions"},"components":[{"name":"Section Container","classes":["section-container"],"components":[{"name":"Section Intro Column","classes":["section-intro-column"],"components":[{"tagName":"span","type":"text","name":"Section Eyebrow","classes":["section-eyebrow"],"components":[{"type":"textnode","content":"Resume Highlights"}]},{"tagName":"h2","type":"heading","name":"Section Title","classes":["gjs-t-h2","font-display","section-title"],"components":[{"type":"textnode","content":"Exhibitions, recognition, and selected press"}]},{"tagName":"p","type":"text","name":"Section Text","classes":["section-text"],"components":[{"type":"textnode","content":"\n              A concise record of recent presentations and mentions that mark the development of the studio practice.\n            "}]}]},{"name":"Timeline Column","classes":["timeline-column"],"components":[{"name":"Timeline Item","classes":["timeline-item"],"components":[{"type":"text","name":"Timeline Year","classes":["font-display","timeline-year"],"components":[{"type":"textnode","content":"2024"}]},{"name":"Timeline Content","classes":["timeline-content"],"components":[{"tagName":"h3","type":"heading","name":"Timeline Title","classes":["timeline-title"],"components":[{"type":"textnode","content":"Solo presentation, Tidal Rooms, Brighton"}]},{"tagName":"p","type":"text","name":"Timeline Description","classes":["timeline-description"],"components":[{"type":"textnode","content":"A new body of atmospheric canvases exploring weather, distance, and emotional cartography."}]}]}]},{"name":"Timeline Item","classes":["timeline-item"],"components":[{"type":"text","name":"Timeline Year","classes":["font-display","timeline-year"],"components":[{"type":"textnode","content":"2023"}]},{"name":"Timeline Content","classes":["timeline-content"],"components":[{"tagName":"h3","type":"heading","name":"Timeline Title","classes":["timeline-title"],"components":[{"type":"textnode","content":"Group exhibition, Material Silence, North Gallery"}]},{"tagName":"p","type":"text","name":"Timeline Description","classes":["timeline-description"],"components":[{"type":"textnode","content":"Featured alongside emerging painters working with restrained palettes and process-led abstraction."}]}]}]},{"name":"Timeline Item","classes":["timeline-item"],"components":[{"type":"text","name":"Timeline Year","classes":["font-display","timeline-year"],"components":[{"type":"textnode","content":"2022"}]},{"name":"Timeline Content","classes":["timeline-content"],"components":[{"tagName":"h3","type":"heading","name":"Timeline Title","classes":["timeline-title"],"components":[{"type":"textnode","content":"Emerging Artist Award shortlist"}]},{"tagName":"p","type":"text","name":"Timeline Description","classes":["timeline-description"],"components":[{"type":"textnode","content":"Recognized for a series of mixed-media paintings developed from coastal field studies and erased drawings."}]}]}]},{"name":"Timeline Item","classes":["timeline-item"],"components":[{"type":"text","name":"Timeline Year","classes":["font-display","timeline-year"],"components":[{"type":"textnode","content":"Press"}]},{"name":"Timeline Content","classes":["timeline-content"],"components":[{"tagName":"h3","type":"heading","name":"Timeline Title","classes":["timeline-title"],"components":[{"type":"textnode","content":"Featured in independent arts journals and regional culture publications"}]},{"tagName":"p","type":"text","name":"Timeline Description","classes":["timeline-description"],"components":[{"type":"textnode","content":"Coverage has focused on process, material sensibility, and the artist’s use of memory as a compositional structure."}]}]}]}]}]}]},{"tagName":"section","name":"Statement Section","classes":["statement-section"],"attributes":{"id":"statement"},"components":[{"name":"Statement Layout","classes":["statement-layout"],"components":[{"name":"Statement Image Column","classes":["statement-image-column"],"components":[{"type":"image","name":"Statement Image","resizable":{"ratioDefault":1},"classes":["statement-image"],"attributes":{"src":"https://app.grapesjs.com/api/assets/random-image?query=artist%20studio%20painting%20process&w=1000&h=1200","alt":"Artist studio process with layered painting materials","width":"1000","height":"1200","loading":"lazy"}}]},{"name":"Statement Text Column","classes":["statement-text-column"],"components":[{"tagName":"span","type":"text","name":"Section Eyebrow","classes":["section-eyebrow"],"components":[{"type":"textnode","content":"Artist Statement"}]},{"tagName":"blockquote","type":"text","name":"Quote Block","classes":["font-display","quote-block"],"components":[{"type":"textnode","content":"\n              “I paint to stay with uncertainty long enough for an image to become felt before it becomes known.”\n            "}]},{"tagName":"p","type":"text","name":"Statement Paragraph","classes":["statement-paragraph"],"components":[{"type":"textnode","content":"\n              My paintings begin with an interest in residue: what remains after a place has been left, after a season has shifted, after an emotion has quieted into atmosphere. I build surfaces slowly, letting color settle and recede. Marks are added, buried, softened, and sometimes removed altogether.\n            "}]},{"tagName":"p","type":"text","name":"Statement Paragraph","classes":["statement-paragraph"],"components":[{"type":"textnode","content":"\n              Rather than describe a specific landscape or room, the work seeks a threshold between recognition and ambiguity. I want the viewer to enter through mood, temperature, rhythm, and memory.\n            "}]},{"name":"Process Tags","classes":["process-tags"],"components":[{"tagName":"span","type":"text","name":"Process Tag","classes":["process-tag"],"components":[{"type":"textnode","content":"Layered pigment"}]},{"tagName":"span","type":"text","name":"Process Tag","classes":["process-tag"],"components":[{"type":"textnode","content":"Charcoal drawing"}]},{"tagName":"span","type":"text","name":"Process Tag","classes":["process-tag"],"components":[{"type":"textnode","content":"Linen & paper"}]},{"tagName":"span","type":"text","name":"Process Tag","classes":["process-tag"],"components":[{"type":"textnode","content":"Textural surfaces"}]}]}]}]}]},{"tagName":"section","name":"Contact Section","classes":["contact-section"],"attributes":{"id":"contact"},"components":[{"name":"Contact Container","classes":["contact-container"],"components":[{"name":"Contact Intro Column","classes":["contact-intro-column"],"components":[{"tagName":"span","type":"text","name":"Section Eyebrow","classes":["section-eyebrow"],"components":[{"type":"textnode","content":"Contact & Commissions"}]},{"tagName":"h2","type":"heading","name":"Contact Title","classes":["font-display","contact-title"],"components":[{"type":"textnode","content":"Interested in a painting, studio visit, or commission?"}]},{"tagName":"p","type":"text","name":"Contact Text","classes":["contact-text"],"components":[{"type":"textnode","content":"\n              For availability, pricing, exhibitions, and bespoke work, reach out directly. Responses typically arrive within two business days.\n            "}]},{"name":"Contact Info List","classes":["contact-info-list"],"components":[{"type":"link","name":"Contact Link","editable":false,"classes":["contact-link"],"attributes":{"href":"mailto:hello@elenamarisstudio.com"},"components":[{"type":"image","name":"Contact Icon","resizable":{"ratioDefault":1},"classes":["contact-icon"],"attributes":{"src":"https://api.iconify.design/lucide-mail.svg?color=%23f5f5f4","alt":"","width":"16","height":"16"}},{"tagName":"span","type":"text","name":"Contact Link Text","components":[{"type":"textnode","content":"hello@elenamarisstudio.com"}]}]},{"type":"link","name":"Contact Link","editable":false,"classes":["contact-link"],"