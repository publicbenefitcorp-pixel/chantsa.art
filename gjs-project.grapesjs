tion","classes":["choice-option"],"components":[{"type":"radio","name":"Radio Input","void":true,"classes":["radio-input"],"attributes":{"type":"radio","name":"interest"}},{"tagName":"span","type":"text","name":"Choice Text","components":[{"type":"textnode","content":"Commission"}]}]},{"type":"label","name":"Choice Option","classes":["choice-option"],"components":[{"type":"radio","name":"Radio Input","void":true,"classes":["radio-input"],"attributes":{"type":"radio","name":"interest"}},{"tagName":"span","type":"text","name":"Choice Text","components":[{"type":"textnode","content":"Exhibition inquiry"}]}]}]}]},{"name":"Form Field","classes":["form-field"],"components":[{"type":"label","name":"Form Label","classes":["form-label"],"attributes":{"for":"message"},"components":[{"type":"textnode","content":"Message"}]},{"type":"textarea","name":"Textarea Input","classes":["textarea-input"],"attributes":{"id":"message","rows":"6","placeholder":"Share what you're looking for, preferred size, timeline, or any questions."}}]},{"name":"Form Footer","classes":["form-footer"],"components":[{"tagName":"p","type":"text","name":"Form Note","classes":["form-note"],"components":[{"type":"textnode","content":"\n                  By sending an inquiry, you agree to be contacted regarding your request.\n                "}]},{"type":"button","name":"Submit Button","classes":["submit-button"],"attributes":{"type":"submit"},"components":[{"type":"contentEditable","components":[{"type":"textnode","content":"\n                  Send Inquiry\n                "}]}]}]}]}]}]}]}]},{"tagName":"footer","name":"Site Footer","classes":["site-footer"],"components":[{"name":"Footer Container","classes":["footer-container"],"components":[{"tagName":"p","type":"text","name":"Footer Copy","classes":["footer-copy"],"components":[{"type":"textnode","content":"Elena Maris Studio"}]},{"name":"Footer Links","classes":["footer-links"],"components":[{"type":"link","name":"Footer Link","classes":["footer-link"],"